<Page
    x:Class="LoginwithDB.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LoginwithDB"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid >
        <Border BorderBrush="Black" BorderThickness="2">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" 
                    VerticalAlignment="Center" Padding="20">
                <TextBlock Text="Login" FontSize="24" FontWeight="Bold" 
                       Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <ComboBox x:Name="txtdropdown" SelectedIndex="0" Width="300" Padding="20">
                    <ComboBoxItem Content="Select Role" IsEnabled="False" />
                    <ComboBoxItem Content="Admin" />
                    <ComboBoxItem Content="User" />
                </ComboBox>
                <TextBlock x:Name="UsernameBlock" Text="Username:" FontSize="16" Margin="0,10,0,0"/>
                <TextBox x:Name="txtusername" PlaceholderText="Enter Username"
                     Width="300" Padding="20" Margin="0,10,0,0"/>
                <TextBlock x:Name="PasswordBlock" Text="Password:" FontSize="16" Margin="0,10,0,0"/>
                <PasswordBox x:Name="txtpassword" PlaceholderText="Enter Password"
                         Width="300" Padding="20" Margin="0,10,0,0"/>
               <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="btnlogin" Content="Login" Width="100" Margin="10,0" Click="btnlogin_Click"/>
                    <Button x:Name="btnreset" Content="Reset" Width="100" Margin="10,0" Click="btnreset_Click" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Page>
